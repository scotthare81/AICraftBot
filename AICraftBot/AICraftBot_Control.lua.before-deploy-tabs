    PALADIN = { 0.96, 0.55, 0.73 },
    UNKNOWN = { 0.80, 0.80, 0.80 }
}

local function UpdateSelectedLabel()
    selectedLabel:SetText(CountSelected() .. " selected")
end

local function UpdateRosterRows()
    local offset = FauxScrollFrame_GetOffset(scrollFrame)
    local i

    for i = 1, visibleRows do
        local row = rows[i]
        local rosterIndex = offset + i
        local bot = roster[rosterIndex]

        if bot then
            row.botName = bot.name
            row.check:SetChecked(IsSelected(bot.name))
            row.text:SetText(bot.name)

            local colour = classColours[bot.class] or classColours.UNKNOWN
            row.text:SetTextColor(colour[1], colour[2], colour[3])

            row:Show()
        else
            row.botName = nil
            row:Hide()
        end
    end

    FauxScrollFrame_Update(
        scrollFrame,
        table.getn(roster),
        visibleRows,
        rowHeight
    )

    UpdateSelectedLabel()
end

local i

for i = 1, visibleRows do
    local row = CreateFrame("Button", nil, rosterPanel)
    row:SetWidth(160)
    row:SetHeight(rowHeight)
    row:SetPoint("TOPLEFT", rosterPanel, "TOPLEFT", 6, -5 - ((i - 1) * rowHeight))

    row.check = CreateFrame("CheckButton", nil, row, "UICheckButtonTemplate")
    row.check:SetWidth(20)
    row.check:SetHeight(20)
    row.check:SetPoint("LEFT", row, "LEFT", 0, 0)

    row.text = row:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
    row.text:SetPoint("LEFT", row.check, "RIGHT", 2, 0)
    row.text:SetJustifyH("LEFT")

    row.check.ownerRow = row

    row.check:SetScript("OnClick", function()
        local owner = this.ownerRow

        if owner and owner.botName then
            if this:GetChecked() then
                selectedBots[owner.botName] = true
            else
                selectedBots[owner.botName] = nil
            end

            UpdateSelectedLabel()
        end
    end)

    row:SetScript("OnClick", function()
        if this.botName then
            local newValue = not IsSelected(this.botName)
            selectedBots[this.botName] = newValue or nil
            this.check:SetChecked(newValue)
            UpdateSelectedLabel()
        end
    end)

    rows[i] = row
end

scrollFrame:SetScript("OnVerticalScroll", function()
    FauxScrollFrame_OnVerticalScroll(
        arg1,
        rowHeight,
        UpdateRosterRows
    )
end)

