local function ShowControlTab()
    deployPanel:Hide()
    controlPanel:Show()
end

local function ShowDeployTab()
    controlPanel:Hide()
    deployPanel:Show()
    RequestBotList()

    Wait(0.8, function()
        BuildAvailableRoster()

        if UpdateDeployRows then
            UpdateDeployRows()
        end
    end)
end

controlTab:SetScript("OnClick", ShowControlTab)
deployTab:SetScript("OnClick", ShowDeployTab)

