    BuildActiveRoster()
    BuildAvailableRoster()
    UpdateActiveRows()
    UpdateDeployRows()
end)

local function ToggleControlFrame()
    if frame:IsVisible() then
        frame:Hide()
    else
        BuildActiveRoster()
        RequestBotList()

        Wait(0.5, function()
            BuildAvailableRoster()
            UpdateActiveRows()
            UpdateDeployRows()
        end)

        frame:Show()
    end
end

