local AICraftControl = {}
local currentMode = 1
local modes = { "TARGET", "PARTY", "RAID" }

local function PrintMessage(text)
    DEFAULT_CHAT_FRAME:AddMessage("|cff33ff99AICraftBot:|r " .. text)
end

local function GetTargetName()
    if not UnitExists("target") then
        return nil
    end

    if not UnitIsPlayer("target") then
        return nil
    end

    if UnitIsEnemy("player", "target") then
        return nil
    end

    if UnitIsUnit("player", "target") then
        return nil
    end

    return UnitName("target")
end

local function SendCommand(command)
    local mode = modes[currentMode]

    if mode == "TARGET" then
        local targetName = GetTargetName()

        if not targetName then
            PrintMessage("Target a friendly bot first.")
            return
        end

        SendChatMessage(command, "WHISPER", nil, targetName)
        PrintMessage(command .. " -> " .. targetName)
        return
    end

    if mode == "RAID" then
        if GetNumRaidMembers() == 0 then
            PrintMessage("You are not in a raid.")
            return
        end

        SendChatMessage(command, "RAID")
        PrintMessage(command .. " -> raid")
        return
    end

    if GetNumPartyMembers() == 0 then
        PrintMessage("You are not in a party.")
        return
    end

    SendChatMessage(command, "PARTY")
    PrintMessage(command .. " -> party")
end

local function CreateButton(parent, text, x, y, width, command)
    local button = CreateFrame("Button", nil, parent, "UIPanelButtonTemplate")
    button:SetWidth(width or 110)
    button:SetHeight(24)
    button:SetPoint("TOPLEFT", parent, "TOPLEFT", x, y)
    button:SetText(text)

    button:SetScript("OnClick", function()
        SendCommand(command)
    end)

    return button
end

