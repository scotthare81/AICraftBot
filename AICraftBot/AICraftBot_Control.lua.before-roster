modeButton:SetText("Current Target")

local function UpdateModeButton()
    local mode = modes[currentMode]

    if mode == "TARGET" then
        modeButton:SetText("Current Target")
    elseif mode == "PARTY" then
        modeButton:SetText("Whole Party")
    else
        modeButton:SetText("Whole Raid")
    end
end

modeButton:SetScript("OnClick", function()
    currentMode = currentMode + 1

    if currentMode > table.getn(modes) then
        currentMode = 1
    end

    UpdateModeButton()
end)

