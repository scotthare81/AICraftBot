AICraftBot = AICraftBot or {}

function AICraftBot.CreateRosterTab(parent)
    local frame = AICraftBot.Tabs.CreatePanel(
        parent,
        "Roster",
        "Active Bot Roster"
    )

    local description = frame:CreateFontString(
        nil,
        "OVERLAY",
        "GameFontHighlight"
    )

    description:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -52)
    description:SetWidth(520)
    description:SetJustifyH("LEFT")
    description:SetText(
        "Bots currently detected in your party or raid."
    )

    local listPanel = CreateFrame("Frame", nil, frame)
    listPanel:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -82)
    listPanel:SetWidth(350)
    listPanel:SetHeight(250)

    listPanel:SetBackdrop({
        bgFile = "Interface\\ChatFrame\\ChatFrameBackground",
        edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
        tile = true,
        tileSize = 16,
        edgeSize = 12,
        insets = {
            left = 3,
            right = 3,
            top = 3,
            bottom = 3,
        },
    })

    listPanel:SetBackdropColor(0, 0, 0, 0.65)

    frame.rows = {}

    local index

    for index = 1, 10 do
        local row = CreateFrame("Button", nil, listPanel)

        row:SetWidth(325)
        row:SetHeight(22)
        row:SetPoint(
            "TOPLEFT",
            listPanel,
            "TOPLEFT",
            8,
            -7 - ((index - 1) * 23)
        )

        row.text = row:CreateFontString(
            nil,
            "OVERLAY",
            "GameFontHighlight"
        )

        row.text:SetPoint("LEFT", row, "LEFT", 4, 0)

        row.classText = row:CreateFontString(
            nil,
            "OVERLAY",
            "GameFontHighlightSmall"
        )

        row.classText:SetPoint("RIGHT", row, "RIGHT", -4, 0)

        row:SetScript("OnEnter", function()
            if not this.botName then
                return
            end

            GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
            GameTooltip:SetText(this.botName)
            GameTooltip:AddLine(
                "Currently in your party or raid.",
                0.3,
                1.0,
                0.3
            )
            GameTooltip:Show()
        end)

        row:SetScript("OnLeave", function()
            GameTooltip:Hide()
        end)

        row:Hide()
        frame.rows[index] = row
    end

    frame.countLabel = frame:CreateFontString(
        nil,
        "OVERLAY",
        "GameFontNormal"
    )

    frame.countLabel:SetPoint(
        "TOPLEFT",
        frame,
        "TOPLEFT",
        390,
        -90
    )

    frame.countLabel:SetText("Active bots: 0")

    local refreshButton = CreateFrame(
        "Button",
        nil,
        frame,
        "UIPanelButtonTemplate"
    )

    refreshButton:SetWidth(150)
    refreshButton:SetHeight(28)
    refreshButton:SetPoint(
        "TOPLEFT",
        frame,
        "TOPLEFT",
        390,
        -125
    )

    refreshButton:SetText("Refresh Roster")

    AICraftBot.UI.SetTooltip(
        refreshButton,
        "Refresh Roster",
        "Rebuilds the roster from your current party or raid."
    )

    local controlButton = CreateFrame(
        "Button",
        nil,
        frame,
        "UIPanelButtonTemplate"
    )

    controlButton:SetWidth(150)
    controlButton:SetHeight(28)
    controlButton:SetPoint(
        "TOPLEFT",
        frame,
        "TOPLEFT",
        390,
        -163
    )

    controlButton:SetText("Open Controls")

    controlButton:SetScript("OnClick", function()
        AICraftBot.Legacy.ShowControl()
    end)

    AICraftBot.UI.SetTooltip(
        controlButton,
        "Open Controls",
        "Opens the existing active bot control interface."
    )

    function frame:RefreshRoster()
        local roster = AICraftBot.Legacy.GetActiveRoster() or {}
        local rowIndex

        self.countLabel:SetText(
            "Active bots: " .. table.getn(roster)
        )

        for rowIndex = 1, table.getn(self.rows) do
            local row = self.rows[rowIndex]
            local bot = roster[rowIndex]

            if bot then
                row.botName = bot.name
                row.text:SetText(bot.name or "Unknown")
                row.classText:SetText(bot.class or "UNKNOWN")

                local colours = AICraftBot.Constants.ClassColours
                local colour = nil

                if colours then
                    colour = colours[bot.class] or colours.UNKNOWN
                end

                if colour then
                    row.text:SetTextColor(
                        colour[1],
                        colour[2],
                        colour[3]
                    )
                else
                    row.text:SetTextColor(1, 1, 1)
                end

                row:Show()
            else
                row.botName = nil
                row.text:SetText("")
                row.classText:SetText("")
                row:Hide()
            end
        end
    end

    refreshButton:SetScript("OnClick", function()
        AICraftBot.Legacy.RefreshActiveRoster()
        frame:RefreshRoster()
    end)

    frame:SetScript("OnShow", function()
        frame:RefreshRoster()
    end)

    return frame
end
