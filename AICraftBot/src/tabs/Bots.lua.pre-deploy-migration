AICraftBot = AICraftBot or {}

function AICraftBot.CreateBotsTab(parent)
    local frame = AICraftBot.Tabs.CreatePanel(
        parent,
        "Bots",
        "Bot Management"
    )

    local description = frame:CreateFontString(
        nil,
        "OVERLAY",
        "GameFontHighlight"
    )

    description:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -55)
    description:SetWidth(520)
    description:SetJustifyH("LEFT")
    description:SetText(
        "Manage bots currently in your group or deploy offline characters."
    )

    local activeButton = CreateFrame(
        "Button",
        nil,
        frame,
        "UIPanelButtonTemplate"
    )

    activeButton:SetWidth(190)
    activeButton:SetHeight(34)
    activeButton:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -95)
    activeButton:SetText("Active Bot Controls")

    activeButton:SetScript("OnClick", function()
        AICraftBot.Legacy.ShowControl()
    end)

    AICraftBot.UI.SetTooltip(
        activeButton,
        "Active Bot Controls",
        "Opens movement, combat and group controls for active bots."
    )

    local deployButton = CreateFrame(
        "Button",
        nil,
        frame,
        "UIPanelButtonTemplate"
    )

    deployButton:SetWidth(190)
    deployButton:SetHeight(34)
    deployButton:SetPoint("TOPLEFT", frame, "TOPLEFT", 225, -95)
    deployButton:SetText("Deploy Bots")

    deployButton:SetScript("OnClick", function()
        AICraftBot.Legacy.ShowDeploy()
    end)

    AICraftBot.UI.SetTooltip(
        deployButton,
        "Deploy Bots",
        "Opens the offline bot list and deployment queue."
    )

    frame.activeCount = frame:CreateFontString(
        nil,
        "OVERLAY",
        "GameFontNormal"
    )

    frame.activeCount:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -155)
    frame.activeCount:SetText("Active bots: 0")

    frame.availableCount = frame:CreateFontString(
        nil,
        "OVERLAY",
        "GameFontNormal"
    )

    frame.availableCount:SetPoint("TOPLEFT", frame, "TOPLEFT", 20, -180)
    frame.availableCount:SetText("Known bots: 0")

    frame:SetScript("OnShow", function()
        local active = AICraftBot.Legacy.GetActiveRoster() or {}
        local available = AICraftBot.Legacy.GetAvailableRoster() or {}

        this.activeCount:SetText(
            "Active bots: " .. table.getn(active)
        )

        this.availableCount:SetText(
            "Known bots: " .. table.getn(available)
        )
    end)

    return frame
end
